{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:runner-server-config:0.1",
  "title": "runner-server-config",
  "type": "object",
  "properties": {
    "config_version": {
      "const": 1
    },
    "runner_id": {
      "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/operation"
    },
    "listen": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^(?:[0-9.]+|\\[[0-9A-Fa-f:]+\\]):[0-9]{1,5}$"
    },
    "state_dir": {
      "type": "string",
      "pattern": "^/[^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "minLength": 2,
      "maxLength": 1024
    },
    "ca_certificate": {
      "type": "string",
      "pattern": "^/[^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "minLength": 2,
      "maxLength": 1024
    },
    "certificate": {
      "type": "string",
      "pattern": "^/[^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "minLength": 2,
      "maxLength": 1024
    },
    "private_key": {
      "type": "string",
      "pattern": "^/[^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "minLength": 2,
      "maxLength": 1024
    },
    "principals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/operation"
          },
          "certificate_sha256": {
            "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/digest"
          }
        },
        "required": [
          "id",
          "certificate_sha256"
        ],
        "additionalProperties": false
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/operation"
          },
          "snapshot": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              },
              "environment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              }
            },
            "required": [
              "name",
              "environment"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "snapshot"
        ],
        "additionalProperties": false
      }
    },
    "grants": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "principal": {
                "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/operation"
              },
              "target": {
                "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/operation"
              },
              "operation_version": {
                "const": 1
              },
              "max_runtime_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600000
              },
              "operation": {
                "const": "task.run"
              },
              "task": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "error-budget"
                  },
                  "version": {
                    "const": 1
                  },
                  "binding_sha256": {
                    "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/digest"
                  }
                },
                "required": [
                  "id",
                  "version",
                  "binding_sha256"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "principal",
              "target",
              "operation_version",
              "max_runtime_ms",
              "operation",
              "task"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "principal": {
                "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/operation"
              },
              "target": {
                "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/operation"
              },
              "operation_version": {
                "const": 1
              },
              "max_runtime_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600000
              },
              "operation": {
                "type": "string",
                "pattern": "^ext\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
                "maxLength": 128
              },
              "package_sha256": {
                "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/digest"
              },
              "policy_sha256": {
                "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/digest"
              }
            },
            "required": [
              "principal",
              "target",
              "operation_version",
              "max_runtime_ms",
              "operation",
              "package_sha256",
              "policy_sha256"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "extension_state_dir": {
      "type": "string",
      "pattern": "^/[^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "minLength": 2,
      "maxLength": 1024
    },
    "extension_policy_path": {
      "type": "string",
      "pattern": "^/[^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "minLength": 2,
      "maxLength": 1024
    },
    "promtool_path": {
      "type": "string",
      "pattern": "^/[^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "minLength": 2,
      "maxLength": 1024
    },
    "changes": {
      "type": "object",
      "properties": {
        "state_dir": {
          "type": "string",
          "pattern": "^/[^\\u0000-\\u001f\\u007f-\\u009f]*$",
          "minLength": 2,
          "maxLength": 1024
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/operation"
              },
              "path": {
                "type": "string",
                "pattern": "^/[^\\u0000-\\u001f\\u007f-\\u009f]*$",
                "minLength": 2,
                "maxLength": 1024
              },
              "validator_binding_sha256": {
                "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/digest"
              },
              "requesters": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/operation"
                }
              },
              "approvers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/operation"
                }
              }
            },
            "required": [
              "id",
              "path",
              "validator_binding_sha256",
              "requesters",
              "approvers"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "state_dir",
        "targets"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "config_version",
    "runner_id",
    "listen",
    "state_dir",
    "ca_certificate",
    "certificate",
    "private_key",
    "principals",
    "targets",
    "grants"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "extension_state_dir": [
      "extension_policy_path"
    ],
    "extension_policy_path": [
      "extension_state_dir"
    ],
    "changes": [
      "promtool_path"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "grants": {
            "contains": {
              "properties": {
                "operation": {
                  "pattern": "^ext\\."
                }
              },
              "required": [
                "operation"
              ]
            }
          }
        }
      },
      "then": {
        "required": [
          "extension_state_dir",
          "extension_policy_path"
        ]
      }
    }
  ]
}
