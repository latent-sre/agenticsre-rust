{
  "title": "Checkout / Health",
  "uid": "checkout-health",
  "tags": [
    "platform",
    "checkout"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "job",
        "type": "query",
        "multi": true,
        "includeAll": true,
        "allValue": ".+"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Is checkout error ratio breaching target?",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "no data"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=~\"$job\"}[$__rate_interval]))"
        }
      ]
    }
  ]
}
