{
  "id": "budget.daily",
  "definition": {
    "enabled": true,
    "timezone": "America/Chicago",
    "cadence": {
      "kind": "daily",
      "at": "02:30"
    },
    "collection": {
      "targets": [
        "service.primary"
      ],
      "task": {
        "id": "error-budget",
        "version": 1,
        "input": {
          "slo": 99.9,
          "bad_minutes": 1
        }
      },
      "concurrency": 1,
      "failure_threshold": 1,
      "timeout_ms": 30000
    },
    "misfire_grace_ms": 60000,
    "retention_limit": 32
  }
}
