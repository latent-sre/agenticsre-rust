{
  "spec_version": "0.1",
  "request_id": "guided-review-example",
  "operation": "runbook.run",
  "operation_version": 1,
  "target": {
    "kind": "local",
    "id": "workstation"
  },
  "inputs": {
    "id": "evidence-review",
    "version": 1,
    "input": {
