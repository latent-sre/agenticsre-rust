{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:runbook-input:0.1",
  "title": "Runbook input",
  "type": "object",
  "properties": {
    "before": {
      "$ref": "urn:sre-workbench:spec:evidence-reference-input:0.1"
    },
    "after": {
      "$ref": "urn:sre-workbench:spec:evidence-reference-input:0.1"
    },
    "normalization": {
      "enum": [
        "exact-window-v1",
        "window-offset-v1"
      ]
    },
    "on_failure": {
      "enum": [
        "stop",
        "continue"
      ]
    }
  },
  "required": [
    "before",
    "after",
    "normalization",
    "on_failure"
  ],
  "additionalProperties": false
}
