            }
          },
          "required": [
            "samples",
            "outcomes",
            "frequency",
            "elapsed",
            "effort",
            "retries",
            "manual_interventions"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "baseline",
        "candidate"
      ],
      "additionalProperties": false
    },
    "costs": {
      "type": "object",
      "properties": {
        "build_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000000
        },
        "maintenance_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000000
        },
        "incident_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000000
        },
        "measurement": {
          "enum": [
            "measured",
            "estimated"
          ]
        },
        "total_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "build_ms",
        "maintenance_ms",
        "incident_ms",
        "measurement",
        "total_ms"
      ],
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "comparable",
            "insufficient_samples",
            "missing_effort"
          ]
        },
        "basis": {
          "const": "counterfactual_comparison"
        },
        "input_measurement": {
          "anyOf": [
            {
              "enum": [
                "measured",
                "estimated"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "gross_per_run_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "observed_gross_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "observed_net_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "break_even_runs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "break_even_state": {
          "enum": [
            "available",
            "no_positive_benefit",
            "unavailable"
          ]
        }
      },
      "required": [
        "state",
        "basis",
        "input_measurement",
        "gross_per_run_ms",
        "observed_gross_ms",
        "observed_net_ms",
        "break_even_runs",
        "break_even_state"
      ],
      "additionalProperties": false
    },
    "projection": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "measurement": {
              "const": "estimated"
            },
            "runs_per_day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "horizon_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            },
            "runs": {
              "type": "integer",
              "minimum": 0
            },
            "gross_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "net_ms": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "measurement",
            "runs_per_day",
            "horizon_days",
            "runs",
            "gross_ms",
            "net_ms"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "expired_samples_excluded": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "limitations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "cancellation_signal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    }
  },
  "required": [
    "format_version",
    "configuration",
    "workflow",
    "window",
    "cohorts",
    "costs",
    "comparison",
    "projection",
    "expired_samples_excluded",
    "limitations"
  ],
  "additionalProperties": false
}
