{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:toil-summary-data:0.1",
  "title": "toil summary data",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1
    },
    "configuration": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        }
      },
      "required": [
        "enabled",
        "retention_days"
      ],
      "additionalProperties": false
    },
    "workflow": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "window": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        "to": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "cohorts": {
      "type": "object",
      "properties": {
        "baseline": {
          "type": "object",
          "properties": {
            "samples": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "outcomes": {
              "type": "object",
              "properties": {
                "succeeded": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "partial": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "cancelled": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "timed_out": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "denied": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "unsupported": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "unknown": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                }
              },
              "required": [
                "succeeded",
                "failed",
                "partial",
                "cancelled",
                "timed_out",
                "denied",
                "unsupported",
                "unknown"
              ],
              "additionalProperties": false
            },
            "frequency": {
              "type": "object",
              "properties": {
                "runs_per_day": {
                  "type": "number",
                  "minimum": 0
                },
                "window_ms": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "runs_per_day",
                "window_ms"
              ],
              "additionalProperties": false
            },
            "elapsed": {
              "type": "object",
              "properties": {
                "known": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "missing": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "measured": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "estimated": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "total_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "mean_ms": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "known",
                "missing",
                "measured",
                "estimated",
                "total_ms",
                "mean_ms"
              ],
              "additionalProperties": false
            },
            "effort": {
              "type": "object",
              "properties": {
                "known": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "missing": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "measured": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "estimated": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "total_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "mean_ms": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "known",
                "missing",
                "measured",
                "estimated",
                "total_ms",
                "mean_ms"
              ],
              "additionalProperties": false
            },
            "retries": {
              "type": "object",
              "properties": {
                "known": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "missing": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                },
                "mean": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "known",
                "missing",
                "total",
                "mean"
              ],
              "additionalProperties": false
            },
            "manual_interventions": {
              "type": "object",
              "properties": {
                "known": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "missing": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                },
                "mean": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "known",
                "missing",
                "total",
                "mean"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "samples",
            "outcomes",
            "frequency",
            "elapsed",
            "effort",
            "retries",
            "manual_interventions"
          ],
          "additionalProperties": false
        },
        "candidate": {
          "type": "object",
          "properties": {
            "samples": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "outcomes": {
              "type": "object",
              "properties": {
                "succeeded": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "partial": {
                  "type": "integer",
                  "minimum": 0,
