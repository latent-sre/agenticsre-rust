            "manual_interventions": {
              "type": "object",
              "properties": {
                "known": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "missing": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                },
                "mean": {
                  "type": [
                    "number",
