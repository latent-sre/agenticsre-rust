                },
                "measured": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "estimated": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "total_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "mean_ms": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "known",
                "missing",
                "measured",
                "estimated",
                "total_ms",
                "mean_ms"
              ],
              "additionalProperties": false
            },
            "effort": {
              "type": "object",
              "properties": {
                "known": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "missing": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "measured": {
                  "type": "integer",
                  "minimum": 0,
