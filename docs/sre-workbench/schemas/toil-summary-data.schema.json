                },
                "denied": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "unsupported": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "unknown": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                }
              },
              "required": [
                "succeeded",
                "failed",
                "partial",
                "cancelled",
                "timed_out",
                "denied",
                "unsupported",
                "unknown"
              ],
              "additionalProperties": false
            },
            "frequency": {
              "type": "object",
              "properties": {
                "runs_per_day": {
                  "type": "number",
                  "minimum": 0
                },
                "window_ms": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "runs_per_day",
                "window_ms"
              ],
              "additionalProperties": false
            },
            "elapsed": {
              "type": "object",
              "properties": {
                "known": {
