{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:extension-policy:0.1",
  "title": "extension-policy",
  "type": "object",
  "properties": {
    "policy_version": {
      "const": 1
    },
    "execution_profile": {
      "const": "operator-reviewed-v1"
    },
    "packages": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "package_sha256": {
            "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/digest"
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^ext\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "package_sha256",
          "capabilities"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "policy_version",
    "execution_profile",
    "packages"
  ],
  "additionalProperties": false
}
