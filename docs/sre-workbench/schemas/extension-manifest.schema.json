{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:extension-manifest:0.1",
  "title": "extension-manifest",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z](?:[a-z0-9]|[._-](?=[a-z0-9]))*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "protocol": {
      "type": "object",
      "properties": {
        "name": {
          "const": "save-extension"
        },
        "version": {
          "const": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "min_spec": {
          "const": "0.1"
        },
        "max_spec": {
          "const": "0.1"
        }
      },
      "required": [
        "min_spec",
        "max_spec"
      ],
      "additionalProperties": false
    },
    "executable": {
      "type": "object",
      "properties": {
        "platform": {
          "const": "linux-x86_64"
        },
        "format": {
          "const": "elf"
        },
        "sha256": {
          "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/digest"
        },
        "bytes": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8388608
        }
      },
      "required": [
        "platform",
        "format",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^ext\\.[a-z](?:[a-z0-9]|[._-](?=[a-z0-9]))*$"
          },
          "version": {
            "const": 1
          },
          "effects": {
            "const": "observe"
          },
          "requested_access": {
            "type": "array",
            "maxItems": 0
          },
          "input_schema": {
            "type": "object",
            "properties": {
              "$schema": {
                "const": "https://json-schema.org/draft/2020-12/schema"
              },
              "type": {
                "const": "object"
              },
              "additionalProperties": {
                "const": false
              },
              "properties": {
                "type": "object",
                "maxProperties": 16,
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "string"
                        },
                        "minLength": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4096
                        },
                        "maxLength": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4096
                        }
                      },
                      "required": [
                        "type",
                        "minLength",
                        "maxLength"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "integer"
                        },
                        "minimum": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "maximum": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "type",
                        "minimum",
                        "maximum"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "boolean"
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                }
              }
            },
            "required": [
              "$schema",
              "type",
              "additionalProperties",
              "properties",
              "required"
            ],
            "additionalProperties": false
          },
          "output_schema": {
            "type": "object",
            "properties": {
              "$schema": {
                "const": "https://json-schema.org/draft/2020-12/schema"
              },
              "type": {
                "const": "object"
              },
              "additionalProperties": {
                "const": false
              },
              "properties": {
                "type": "object",
                "maxProperties": 16,
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "string"
                        },
                        "minLength": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4096
                        },
                        "maxLength": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4096
                        }
                      },
                      "required": [
                        "type",
                        "minLength",
                        "maxLength"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "integer"
                        },
                        "minimum": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "maximum": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "type",
                        "minimum",
                        "maximum"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "boolean"
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                }
              }
            },
            "required": [
              "$schema",
              "type",
              "additionalProperties",
              "properties",
              "required"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "operation",
          "version",
          "effects",
          "requested_access",
          "input_schema",
          "output_schema"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        }
      },
      "required": [
        "source",
        "revision",
        "license"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "version",
    "protocol",
    "compatibility",
    "executable",
    "capabilities",
    "provenance"
  ],
  "additionalProperties": false
}
