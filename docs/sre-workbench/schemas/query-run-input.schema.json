{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:query-run-input:0.1",
  "title": "Installed saved query invocation",
  "type": "object",
  "properties": {
    "id": {
      "enum": [
        "prometheus.up-by-job",
        "loki.logs-by-job"
      ]
    },
    "version": {
      "const": 1
    },
    "datasource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "parameters": {
      "type": "object",
      "properties": {
        "job": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Literal job label value; runtime additionally enforces 128 UTF-8 bytes and the legacy macro guard.",
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        }
      },
      "required": [
        "job"
      ],
      "additionalProperties": false
    },
    "window": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "absolute"
            },
            "from": {
              "type": "string",
              "format": "date-time"
            },
            "to": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "kind",
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "relative"
            },
            "lookback_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          },
          "required": [
            "kind",
            "lookback_seconds"
          ],
          "additionalProperties": false
        }
      ]
    },
    "expected_definition_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    }
  },
  "required": [
    "id",
    "version",
    "datasource",
    "parameters",
    "window"
  ],
  "additionalProperties": false
}
