{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:change-plan-input:0.1",
  "title": "change-plan-input",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "target": {
      "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/operation"
    },
    "proposed_base64": {
      "type": "string",
      "minLength": 0,
      "maxLength": 43692,
      "pattern": "^(?:[A-Za-z0-9+/]{4}){0,10922}(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?$",
      "description": "Canonical RFC 4648 base64 with at most 32768 decoded bytes; exact bytes and digest remain runtime checks."
    },
    "expires_in_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 900
    }
  },
  "required": [
    "request_id",
    "target",
    "proposed_base64",
    "expires_in_seconds"
  ],
  "additionalProperties": false
}
