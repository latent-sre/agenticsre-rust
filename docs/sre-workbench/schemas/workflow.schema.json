{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:workflow:0.1",
  "title": "SRE Workbench workflow draft 0.1",
  "type": "object",
  "properties": {
    "spec_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "diagnostic_pack",
        "runbook"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "input_schema": {
      "type": "object"
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "operation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "operation_version": {
            "type": "integer",
            "minimum": 1
          },
          "inputs": {
            "type": "object"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "maxLength": 128
            },
            "maxItems": 50,
            "uniqueItems": true
          },
          "on_failure": {
            "enum": [
              "stop",
              "continue"
            ]
          },
          "when": {
            "type": "object",
            "properties": {
              "step": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "pointer": {
                "type": "string",
                "pattern": "^(?:/.*)?$",
                "maxLength": 1024
              },
              "operator": {
                "enum": [
                  "exists",
                  "equals"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "step",
              "pointer",
              "operator"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "operator": {
                      "const": "equals"
                    }
                  }
                },
                "then": {
                  "required": [
                    "value"
                  ]
                }
              }
            ]
          },
          "checkpoint": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "operation",
          "operation_version",
          "inputs",
          "depends_on",
          "on_failure"
        ],
        "additionalProperties": false
      },
      "maxItems": 50,
      "minItems": 1
    }
  },
  "required": [
    "spec_version",
    "id",
    "version",
    "kind",
    "description",
    "input_schema",
    "max_steps",
    "timeout_ms",
    "concurrency",
    "steps"
  ],
  "additionalProperties": false
}
