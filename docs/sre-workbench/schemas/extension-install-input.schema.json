{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:extension-install-input:0.1",
  "title": "extension-install-input",
  "type": "object",
  "properties": {
    "package": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      },
      "pattern": "^/"
    },
    "expected_package_sha256": {
      "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/digest"
    }
  },
  "required": [
    "package",
    "expected_package_sha256"
  ],
  "additionalProperties": false
}
