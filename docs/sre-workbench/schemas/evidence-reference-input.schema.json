{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:evidence-reference-input:0.1",
  "title": "Generated local evidence reference",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^run-[0-9]+-[a-f0-9]+-[a-f0-9]+$"
    },
    "expected_manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "minLength": 71,
      "maxLength": 71
    }
  },
  "required": [
    "id"
  ],
  "additionalProperties": false
}
