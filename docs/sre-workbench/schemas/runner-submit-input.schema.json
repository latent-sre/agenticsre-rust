{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:runner-submit-input:0.1",
  "title": "runner-submit-input",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target": {
      "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/operation"
    },
    "operation": {
      "oneOf": [
        {
          "const": "task.run"
        },
        {
          "type": "string",
          "pattern": "^ext\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "maxLength": 128
        }
      ]
    },
    "operation_version": {
      "const": 1
    },
    "inputs": {
      "type": "object"
    },
    "max_runtime_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "retain_events": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    }
  },
  "required": [
    "request_id",
    "target",
    "operation",
    "operation_version",
    "inputs",
    "max_runtime_ms",
    "retain_events"
  ],
  "additionalProperties": false
}
