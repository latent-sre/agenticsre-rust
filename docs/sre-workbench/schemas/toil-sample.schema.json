{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:toil-sample:0.1",
  "title": "toil sample",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^sample-[0-9]+-[a-f0-9]+-[a-f0-9]+$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "workflow": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "cohort": {
      "enum": [
        "baseline",
        "candidate"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "elapsed_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000000
        },
        {
          "type": "null"
        }
      ]
    },
    "elapsed_measurement": {
      "anyOf": [
        {
          "enum": [
            "measured",
            "estimated"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "effort_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000000
        },
        {
          "type": "null"
        }
      ]
    },
    "effort_measurement": {
      "anyOf": [
        {
          "enum": [
            "measured",
            "estimated"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "effort_provenance": {
      "enum": [
        null,
        "operator_reported",
        "operator_annotated"
      ]
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed",
        "partial",
        "cancelled",
        "timed_out",
        "denied",
        "unsupported",
        "unknown"
      ]
    },
    "retries": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "manual_interventions": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "enum": [
        "operator_reported",
        "task_capture"
      ]
    },
    "task": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "enum": [
                "dashboard-hygiene",
                "error-budget"
              ]
            },
            "version": {
              "const": 1
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_run_id": {
      "anyOf": [
        {
          "$ref": "urn:sre-workbench:spec:evidence-reference-input:0.1#/properties/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "annotated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "workflow",
    "cohort",
    "observed_at",
    "elapsed_ms",
    "elapsed_measurement",
    "effort_ms",
    "effort_measurement",
    "effort_provenance",
    "outcome",
    "retries",
    "manual_interventions",
    "source",
    "task",
    "operation_run_id",
    "annotated_at"
  ],
  "additionalProperties": false
}
