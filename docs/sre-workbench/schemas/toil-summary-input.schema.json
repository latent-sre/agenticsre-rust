{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:toil-summary-input:0.1",
  "title": "toil summary input",
  "type": "object",
  "properties": {
    "workflow": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "from": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "to": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "costs": {
      "type": "object",
      "properties": {
        "build_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000000
        },
        "maintenance_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000000
        },
        "incident_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000000
        },
        "measurement": {
          "enum": [
            "measured",
            "estimated"
          ]
        }
      },
      "required": [
        "build_ms",
        "maintenance_ms",
        "incident_ms",
        "measurement"
      ],
      "additionalProperties": false
    },
    "projection": {
      "type": "object",
      "properties": {
        "runs_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "horizon_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        }
      },
      "required": [
        "runs_per_day",
        "horizon_days"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "workflow",
    "from",
    "to",
    "costs"
  ],
  "additionalProperties": false
}
