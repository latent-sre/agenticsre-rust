{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:read-profile-data:0.1",
  "title": "Restricted Linux command observation data",
  "type": "object",
  "properties": {
    "profile": {
      "const": "linux-read-v1"
    },
    "effects": {
      "const": "observe"
    },
    "execution_performed": {
      "type": "boolean"
    },
    "inspection_advisory": {
      "type": "boolean"
    },
    "policy": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "sha256"
      ],
      "additionalProperties": false
    },
    "root": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/"
        },
        "device": {
          "type": "integer",
          "minimum": 0
        },
        "inode": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "path",
        "device",
        "inode"
      ],
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "git",
            "rg"
          ]
        },
        "binding": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^/"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "device": {
              "type": "integer",
              "minimum": 0
            },
            "inode": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "path",
            "sha256",
            "device",
            "inode"
          ],
          "additionalProperties": false
        },
        "normalized_args": {
          "type": "array",
          "maxItems": 160,
          "items": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "execution_confirmed": {
          "type": "boolean"
        },
        "exit_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 255
        },
        "status_encoding": {
          "const": "exit_or_128_plus_signal"
        }
      },
      "required": [
        "name",
        "binding",
        "normalized_args",
        "execution_confirmed",
        "exit_status",
        "status_encoding"
      ],
      "additionalProperties": false
    },
    "wrapper": {
      "type": "object",
      "properties": {
        "binding": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^/"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "device": {
              "type": "integer",
              "minimum": 0
            },
            "inode": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "path",
            "sha256",
            "device",
            "inode"
          ],
          "additionalProperties": false
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 255
        },
        "signal": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        }
      },
      "required": [
        "binding",
        "exit_code",
        "signal"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "device": {
            "type": "integer",
            "minimum": 0
          },
          "inode": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "device",
          "inode"
        ],
        "additionalProperties": false
      }
    },
    "isolation": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "required",
            "confirmed",
            "unconfirmed"
          ]
        },
        "namespaces": {
          "const": [
            "user",
            "mount",
            "network",
            "pid",
            "ipc",
            "uts"
          ]
        },
        "root_read_only": {
          "const": true
        },
        "proc_mounted": {
          "const": false
        },
        "tmp_bytes": {
          "const": 16777216
        },
        "no_new_privileges": {
          "const": true
        },
        "capabilities": {
          "const": "none"
        },
        "seccomp": {
          "const": "x86_64-read-v1"
        },
        "writable_file_opens": {
          "const": "private_dev_null_only"
        },
        "socket_syscalls": {
          "const": false
        },
        "landlock_minimum_abi": {
          "const": 5
        }
      },
      "required": [
        "state",
        "namespaces",
        "root_read_only",
        "proc_mounted",
        "tmp_bytes",
        "no_new_privileges",
        "capabilities",
        "seccomp",
        "writable_file_opens",
        "socket_syscalls",
        "landlock_minimum_abi"
      ],
      "additionalProperties": false
    },
    "supervisor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "process_id": {
              "type": "integer",
              "minimum": 1
            },
            "process_group_id": {
              "type": "integer",
              "minimum": 1
            },
            "cancellation_signal": {
              "enum": [
                null,
                2,
                15
              ]
            },
            "stdout_bytes_observed": {
              "type": "integer",
              "minimum": 0
            },
            "stderr_bytes_observed": {
              "type": "integer",
              "minimum": 0
            },
            "cleanup": {
              "type": "object",
              "properties": {
                "trigger": {
                  "enum": [
                    null,
                    "timeout",
                    "cancellation",
                    "result_consumer_closed",
                    "descendants_after_leader_exit",
                    "supervisor_io_error"
                  ]
                },
                "term_sent": {
                  "type": "boolean"
                },
                "kill_sent": {
                  "type": "boolean"
                },
                "group_absent": {
                  "type": "boolean"
                },
                "primary_reaped": {
                  "type": "boolean"
                },
                "stdout_closed": {
                  "type": "boolean"
                },
                "stderr_closed": {
                  "type": "boolean"
                },
                "confirmed": {
                  "type": "boolean"
                },
                "grace_ms": {
                  "const": 2000
                },
                "final_drain_ms": {
                  "const": 500
                },
                "scope": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "required": [
                "trigger",
                "term_sent",
                "kill_sent",
                "group_absent",
                "primary_reaped",
                "stdout_closed",
                "stderr_closed",
                "confirmed",
                "grace_ms",
                "final_drain_ms",
                "scope"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "process_id",
            "process_group_id",
            "cancellation_signal",
            "stdout_bytes_observed",
            "stderr_bytes_observed",
            "cleanup"
          ],
          "additionalProperties": false
        }
      ]
    },
    "cancellation_signal": {
      "enum": [
        null,
        2,
        15
      ]
    },
    "launcher": {
      "type": "object",
      "properties": {
        "binding": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^/"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "device": {
              "type": "integer",
              "minimum": 0
            },
            "inode": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "path",
            "sha256",
            "device",
            "inode"
          ],
          "additionalProperties": false
        },
        "state": {
          "enum": [
            "required",
            "unconfirmed",
            "admitted",
            "tool_started",
            "tool_exited",
            "setup_failed",
            "exec_failed"
          ]
        },
        "landlock_abi": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 5,
          "maximum": 1024
        }
      },
      "required": [
        "binding",
        "state",
        "landlock_abi"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "profile",
    "effects",
    "execution_performed",
    "inspection_advisory",
    "policy",
    "root",
    "tool",
    "wrapper",
    "runtime",
    "isolation",
    "supervisor",
    "cancellation_signal",
    "launcher"
  ],
  "additionalProperties": false
}
