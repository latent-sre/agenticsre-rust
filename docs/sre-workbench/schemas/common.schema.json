{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:common:0.1",
  "title": "SRE Workbench common draft 0.1",
  "$defs": {
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "local",
            "connection",
            "service",
            "runner"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "service"
              }
            }
          },
          "then": {
            "required": [
              "environment"
            ]
          }
        }
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 2097152
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "required": [
        "timeout_ms",
        "max_output_bytes"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "maxLength": 1024
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "restricted"
          ]
        }
      },
      "required": [
        "path",
        "media_type",
        "bytes",
        "digest",
        "classification"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_state": {
          "enum": [
            "verified",
            "sourced",
            "unverified"
          ]
        },
        "untrusted": {
          "type": "boolean"
        }
      },
      "required": [
        "reference",
        "observed_at",
        "evidence_state",
        "untrusted"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "maxLength": 1024
    }
  }
}
