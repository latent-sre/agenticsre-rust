{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:schedule-run-now-input:0.1",
  "title": "schedule.run-now input",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "urn:sre-workbench:spec:common:0.1#/$defs/operation",
      "maxLength": 64
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000]+$"
    }
  },
  "required": [
    "id",
    "expected_revision",
    "request_id"
  ],
  "additionalProperties": false
}
