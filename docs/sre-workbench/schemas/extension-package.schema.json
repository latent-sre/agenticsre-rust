{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:extension-package:0.1",
  "title": "extension-package",
  "type": "object",
  "properties": {
    "package_format": {
      "const": 1
    },
    "manifest": {
      "$ref": "urn:sre-workbench:spec:extension-manifest:0.1"
    },
    "executable_base64": {
      "type": "string",
      "minLength": 88,
      "maxLength": 11184812,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  },
  "required": [
    "package_format",
    "manifest",
    "executable_base64"
  ],
  "additionalProperties": false
}
