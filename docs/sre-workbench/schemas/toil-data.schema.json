{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:toil-data:0.1",
  "title": "toil data",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "configuration": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "retention_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            }
          },
          "required": [
            "enabled",
            "retention_days"
          ],
          "additionalProperties": false
        },
        "samples_retained": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "cancellation_signal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "format_version",
        "configuration",
        "samples_retained"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "sample": {
          "$ref": "urn:sre-workbench:spec:toil-sample:0.1"
        },
        "recording": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "complete",
                "failed",
                "unknown",
                "not_attempted"
              ]
            },
            "sample_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 96,
                  "pattern": "^sample-[0-9]+-[a-f0-9]+-[a-f0-9]+$",
                  "not": {
                    "pattern": "[\\r\\n]"
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "state",
            "sample_id"
          ],
          "additionalProperties": false
        },
        "cancellation_signal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "format_version",
        "sample",
        "recording"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "child": {
          "$ref": "urn:sre-workbench:spec:result:0.1"
        },
        "sample": {
          "anyOf": [
            {
              "$ref": "urn:sre-workbench:spec:toil-sample:0.1"
            },
            {
              "type": "null"
            }
          ]
        },
        "recording": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "complete",
                "failed",
                "unknown",
                "not_attempted"
              ]
            },
            "sample_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 96,
                  "pattern": "^sample-[0-9]+-[a-f0-9]+-[a-f0-9]+$",
                  "not": {
                    "pattern": "[\\r\\n]"
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "state",
            "sample_id"
          ],
          "additionalProperties": false
        },
        "child_payload_omitted": {
          "type": "boolean"
        },
        "cancellation_signal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "format_version",
        "child",
        "sample",
        "recording",
        "child_payload_omitted"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "deleted": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^sample-[0-9]+-[a-f0-9]+-[a-f0-9]+$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          }
        },
        "remaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "cancellation_signal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "format_version",
        "deleted",
        "remaining"
      ],
      "additionalProperties": false
    },
    {
      "$ref": "urn:sre-workbench:spec:toil-summary-data:0.1"
    }
  ]
}
