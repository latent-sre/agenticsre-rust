{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:extension-protocol-frame:0.1",
  "title": "extension-protocol-frame",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocol": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "\\u0000"
          }
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "\\u0000"
          }
        },
        "sequence": {
          "const": 0
        },
        "kind": {
          "const": "hello"
        }
      },
      "required": [
        "protocol",
        "request_id",
        "run_id",
        "sequence",
        "kind"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "\\u0000"
          }
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "\\u0000"
          }
        },
        "sequence": {
          "const": 1
        },
        "kind": {
          "const": "request"
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^ext\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "operation_version": {
          "const": 1
        },
        "inputs": {
          "type": "object"
        },
        "limits": {
          "type": "object",
          "properties": {
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600000
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 1048576
            }
          },
          "required": [
            "timeout_ms",
            "max_output_bytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocol",
        "request_id",
        "run_id",
        "sequence",
        "kind",
        "operation",
        "operation_version",
        "inputs",
        "limits"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "\\u0000"
          }
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "\\u0000"
          }
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63
        },
        "kind": {
          "const": "progress"
        },
        "message": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024
        }
      },
      "required": [
        "protocol",
        "request_id",
        "run_id",
        "sequence",
        "kind",
        "message"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "\\u0000"
          }
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "\\u0000"
          }
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63
        },
        "kind": {
          "const": "result"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "maxProperties": 16,
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 4096
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "protocol",
        "request_id",
        "run_id",
        "sequence",
        "kind",
        "status",
        "data",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "maxProperties": 16,
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 4096
                    },
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              },
              "error": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "data": {
                "type": "null"
              },
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    }
  ]
}
