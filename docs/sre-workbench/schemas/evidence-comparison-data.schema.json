              "maxLength": 71
            }
          },
          "required": [
            "id",
            "digest"
          ],
          "additionalProperties": false
        },
        "window": {
          "type": "object",
          "properties": {
            "from": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "format": "date-time"
                },
                {
                  "type": "object",
                  "properties": {
                    "redacted": {
                      "const": true
                    }
                  },
                  "required": [
                    "redacted"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "to": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "format": "date-time"
                },
                {
                  "type": "object",
                  "properties": {
                    "redacted": {
                      "const": true
                    }
                  },
                  "required": [
                    "redacted"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        "capture": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "none",
                "partial",
                "complete"
              ]
            },
            "expected_steps": {
              "const": 2
            },
            "retained_receipts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            }
          },
          "required": [
            "state",
            "expected_steps",
            "retained_receipts"
          ],
          "additionalProperties": false
        },
        "manifest_state": {
          "enum": [
            "sealed",
            "interrupted"
          ]
        },
        "started_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "finalized_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "bundle",
        "window",
        "capture",
        "manifest_state",
        "started_at",
        "finalized_at"
      ],
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "compatible",
            "incompatible"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
