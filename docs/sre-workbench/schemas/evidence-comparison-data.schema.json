                    "type": "integer",
                    "minimum": 0
                  },
                  "series_removed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "samples_added": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "samples_removed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "samples_changed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "samples_missing": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "samples_unchanged": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sampling": {
                    "type": "object",
                    "properties": {
                      "request_interval_ms": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "before_declared_intervals_ms": {
                        "type": "array",
                        "items": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 1
                        },
                        "maxItems": 512
                      },
                      "after_declared_intervals_ms": {
                        "type": "array",
                        "items": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 1
                        },
                        "maxItems": 512
                      }
                    },
                    "required": [
                      "request_interval_ms",
                      "before_declared_intervals_ms",
                      "after_declared_intervals_ms"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "before",
                  "after",
                  "series_added",
                  "series_removed",
                  "samples_added",
                  "samples_removed",
                  "samples_changed",
                  "samples_missing",
                  "samples_unchanged",
                  "sampling"
