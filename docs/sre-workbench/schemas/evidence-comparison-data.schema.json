                        {
                          "type": "null"
                        }
                      ]
                    },
                    "before_nonfinite": {
                      "enum": [
                        "NaN",
                        "Inf",
                        "NegInf"
                      ]
                    },
                    "after_nonfinite": {
                      "enum": [
                        "NaN",
                        "Inf",
                        "NegInf"
                      ]
                    }
                  },
