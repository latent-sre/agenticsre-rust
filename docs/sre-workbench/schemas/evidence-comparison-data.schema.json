                    "required": [
                      "entries",
                      "label_sets"
                    ],
                    "additionalProperties": false
                  },
                  "after": {
                    "type": "object",
                    "properties": {
                      "entries": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "label_sets": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "entries",
                      "label_sets"
                    ],
                    "additionalProperties": false
                  },
                  "entries_added": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "entries_removed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "entries_unchanged": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "before",
                  "after",
                  "entries_added",
                  "entries_removed",
                  "entries_unchanged"
                ],
                "additionalProperties": false
              }
            ]
          },
          "details": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "series_added",
                        "series_removed"
                      ]
                    },
                    "series": {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string",
                          "maxLength": 256
                        },
                        "labels": {
                          "type": "object",
                          "maxProperties": 64,
                          "propertyNames": {
                            "maxLength": 256
                          },
                          "additionalProperties": {
                            "type": "string",
                            "maxLength": 2048
                          }
                        }
                      },
                      "required": [
                        "field",
                        "labels"
                      ],
                      "additionalProperties": false
