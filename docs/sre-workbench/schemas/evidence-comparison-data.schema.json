{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-workbench:spec:evidence-comparison-data:0.1",
  "title": "Returned-observation comparison data",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1
    },
    "algorithm": {
      "const": "returned-observations-v1"
    },
    "normalization": {
      "enum": [
        "exact-window-v1",
        "window-offset-v1"
      ]
    },
    "scope": {
      "const": "returned_observations"
    },
    "state": {
      "enum": [
        "complete",
        "partial",
        "incompatible"
      ]
    },
    "before": {
      "type": "object",
      "properties": {
        "bundle": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^run-[0-9]+-[a-f0-9]+-[a-f0-9]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$",
              "minLength": 71,
              "maxLength": 71
            }
          },
          "required": [
            "id",
            "digest"
          ],
          "additionalProperties": false
        },
        "window": {
          "type": "object",
          "properties": {
            "from": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "format": "date-time"
                },
                {
                  "type": "object",
                  "properties": {
                    "redacted": {
                      "const": true
                    }
                  },
                  "required": [
                    "redacted"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "to": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "format": "date-time"
                },
                {
                  "type": "object",
                  "properties": {
                    "redacted": {
                      "const": true
                    }
                  },
                  "required": [
                    "redacted"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        "capture": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "none",
                "partial",
                "complete"
              ]
            },
            "expected_steps": {
              "const": 2
            },
            "retained_receipts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            }
          },
          "required": [
            "state",
            "expected_steps",
            "retained_receipts"
          ],
          "additionalProperties": false
        },
        "manifest_state": {
          "enum": [
            "sealed",
            "interrupted"
          ]
        },
        "started_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "format": "date-time"
        },
        "finalized_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "bundle",
        "window",
        "capture",
        "manifest_state",
        "started_at",
        "finalized_at"
      ],
      "additionalProperties": false
    },
    "after": {
      "type": "object",
      "properties": {
        "bundle": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^run-[0-9]+-[a-f0-9]+-[a-f0-9]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$",
