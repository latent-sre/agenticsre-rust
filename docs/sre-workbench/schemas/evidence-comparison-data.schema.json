                    "before_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "after_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "before_timestamp_ns": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^-?[0-9]+$",
                          "maxLength": 40
                        },
                        {
                          "type": "null"
