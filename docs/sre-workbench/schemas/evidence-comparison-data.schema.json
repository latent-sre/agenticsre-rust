              {
                "type": "object",
                "properties": {
                  "before": {
                    "type": "object",
                    "properties": {
                      "series": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "samples": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "missing": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "nonfinite": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "sampling_gaps": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "series",
                      "samples",
                      "missing",
                      "nonfinite",
                      "sampling_gaps"
                    ],
                    "additionalProperties": false
                  },
                  "after": {
                    "type": "object",
                    "properties": {
                      "series": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "samples": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "missing": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "nonfinite": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "sampling_gaps": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "series",
                      "samples",
                      "missing",
                      "nonfinite",
                      "sampling_gaps"
                    ],
                    "additionalProperties": false
